<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/item_icon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_default"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/main_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/item_icon"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/main_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Доп. инфо"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/main_first"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/add_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавочная инфо"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/main_second"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/add_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID элемента"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/add_first"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
